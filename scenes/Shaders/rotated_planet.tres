[gd_resource type="Shader" format=3 uid="uid://bxxr6mev6gwpx"]

[resource]
code = "shader_type canvas_item;

uniform float aspect_ratio = 2.0;
uniform float rotation_speed = 0.3;
uniform bool as_shadow = false;

void fragment() {
	float px = 2.0 * (UV.x - 0.5);
	float py = 2.0 * (UV.y - 0.5);
	float radius = px * px + py * py;

	if (radius > 1.0) {
		COLOR = vec4(0.0);
		return;
	}

	float safe_y = max(1.0 - py * py, 0.0001);
	float sphere_x = asin(clamp(px / sqrt(safe_y), -1.0, 1.0)) * 2.0 / PI;
	float sphere_y = asin(clamp(py, -1.0, 1.0)) * 2.0 / PI;

	float planet_u = 0.5 * (sphere_x + 1.0) / aspect_ratio;
	planet_u = fract(planet_u - TIME * rotation_speed);

	float planet_v = 0.5 * (sphere_y + 1.0);
	planet_v = clamp(planet_v, 0.0, 1.0);

	COLOR = texture(TEXTURE, vec2(planet_u, planet_v));

	if (as_shadow) {
		COLOR.rgb = vec3(0.0);
		COLOR.a *= 0.9;
	}
}"